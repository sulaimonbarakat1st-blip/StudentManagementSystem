@{
    ViewData["Title"] = "Change Password";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
   

    .profile-wrapper {
        background: #F8F7FF;
        min-height: 85vh;
        width: 100vw !important;
        max-width: 100vw !important;
        margin-left: calc(-50vw + 50%) !important;
        padding: 16px !important;
        box-sizing: border-box !important;
    }
    .profile-card {
        background: white;
        border-radius: 16px;
        padding: 30px;
        max-width: 100% !important;
        width: 100% !important;
        margin: 0 !important;
        box-shadow: 0 4px 20px rgba(112, 76, 255, 0.12);
    }

    .header-icon{width:48px;height:48px;background:rgba(255,255,255,0.25); border-radius:12px; display:flex; align-items:center; justify-content:center;}
    .header-icon svg{width:24px;height:24px; fill:white;}
    .profile-body{padding:32px;}
    label{font-size:20px; font-weight:1000; color:#333; margin-top:16px; display:block;}
    .field{background:#f8f7ff; border:1.5px solid #efeaff; border-radius:10px; display:flex; align-items:center; padding:12px 14px; margin-top:6px; transition:0.2s;}
    .field:focus-within{border-color:#8b5cf6; background:#f3f0ff; box-shadow:0 0 0 3px rgba(139,92,246,0.1);}
    .field svg{width:20px; height:20px; fill:#8b5cf6; margin-right:12px; flex-shrink:0;}
    .field input{background:transparent; border:none; outline:none; width:100%; font-size:18px; color:#222;}
    .field input::placeholder{color:#aaa;}
    .btn-purple{background:#8b5cf6; color:white; border:none; padding:12px 28px; border-radius:20px; font-weight:1000; font-size:13px; cursor:pointer; margin-top:24px;}
    .btn-purple:hover{background:#7c3aed;}
    .btn-outline{background:white; border:1.5px solid #eaeaf0; color:#666; padding:12px 24px; border-radius:10px; font-weight:800; font-size:22px; text-decoration:none; margin-left:10px;}
    .info-box{background:#f3f0ff; border-left:3px solid #8b5cf6; border-radius:8px; padding:12px 16px; margin-bottom:22px; font-size:11px; color:#6b5b95; line-height:1.5;}
</style>

<div class="profile-wrapper">
    <div class="profile-card">
        <div class="profile-header">
            <div class="header-icon">
                <svg viewBox="0 0 24 24"><path d="M18 8h-1V6c0-2.8-2.2-5-5-5S7 3.2 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.7 1.4-3.1 3.1-3.1s3.1 1.4 3.1 3.1v2z"/></svg>
            </div>
            <div>
                <h4 style="margin:0; font-weight:1200; font-size:22px;">Change Password</h4>
                <p style="margin:2px 0 0; font-size:15px; opacity:0.9;">Keep your account secure with a strong password</p>
            </div>
        </div>

        <div class="profile-body">
            <div class="info-box">
                🔒 Your password must be at least 6 characters and include a mix of letters and numbers for security.
            </div>

            <form method="post" action="/Account/ChangePassword">
                <label>Current Password</label>
                <div class="field">
                    <svg viewBox="0 0 24 24"><path d="M12 17a2 2 0 0 0 2-2 2 2 0 0 0-2-2 2 2 0 0 0-2 2 2 2 0 0 0 2 2m6-9a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V10a2 2 0 0 1 2-2h1V6a5 5 0 0 1 10 0v2h1m-6-5a3 3 0 0 0-3 3v2h6V6a3 3 0 0 0-3-3z"/></svg>
                    <input type="password" name="OldPassword" placeholder="Enter current password" required />
                </div>

                <label>New Password</label>
                <div class="field">
                    <svg viewBox="0 0 24 24"><path d="M18 8h-1V6c0-2.8-2.2-5-5-5S7 3.2 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.7 1.4-3.1 3.1-3.1s3.1 1.4 3.1 3.1v2z"/></svg>
                    <input type="password" name="NewPassword" placeholder="Enter new password" required />
                </div>

                <label>Confirm New Password</label>
                <div class="field">
                    <svg viewBox="0 0 24 24"><path d="M12 1L3 5v6c0 5.5 3.8 10.7 9 12 5.2-1.3 9-6.5 9-12V5l-9-4zm-2 16l-4-4 1.4-1.4 2.6 2.6 6-6L17.4 7l-7.4 7.4z"/></svg>
                    <input type="password" name="ConfirmPassword" placeholder="Confirm new password" required />
                </div>

                <div style="margin-top:10px;">
                    <button type="submit" class="btn-purple">Update Password →</button>
                    <a href="/Account/Profile" class="btn-outline">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>