@model StudentManagementSystem.Models.User
@{
    ViewData["Title"] = "My Profile";
}
<style>
    
    /* FORCE FULL SCREEN - ADD THIS AT BOTTOM */
.page-bg{
  width: 100vw !important;
  margin-left: calc(-50vw + 50%) !important;
  max-width: 100vw !important;
  min-height: 100vh !important;
  box-sizing: border-box !important;
}
.header, .grid{
  max-width: 100% !important;
  width: 100% !important;
  margin-left: 0 !important;
  margin-right: 0 !important;
}
    body {
        background-color: #ede9fe !important;
    }

    .container {
        max-width: 100% !important;
        padding: 0 !important;
        margin: 0 !important;
    }

    .profile-wrapper {
        background-color: #ede9fe;
        min-height: 100vh;
        width: 100vw;
        display: flex;
        justify-content: center;
        align-items: center; /* centers vertically */
        padding: 0;
        margin-left: calc(-50vw + 50%);
    }

    .profile-card {
        background: white;
        width: 55%; /* HALF of the screen */
        min-width: 750px;
        min-height: 55vh;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 25px 60px rgba(91, 60, 196, 0.25);
        font-weight: 700;
    }

    .profile-header {
        background: linear-gradient(135deg, #7c5cbf 0%, #5b3cc4 100%);
        color: white;
        padding: 35px 40px;
        display: flex;
        align-items: center;
        gap: 20px;
    }

        .profile-header h2 {
            font-weight: 900;
            font-size: 28px;
            margin: 0;
            letter-spacing: -0.5px;
        }

    .profile-body {
        padding: 35px 40px;
    }

    .info-box {
        background: #f8f7ff;
        border-left: 4px solid #7c5cbf;
        padding: 16px 18px;
        border-radius: 10px;
        margin-bottom: 18px;
    }

        .info-box label {
            font-size: 10px;
            color: #888;
            text-transform: uppercase;
            font-weight: 900;
            display: block;
            margin-bottom: 4px;
        }

        .info-box span {
            font-weight: 800;
            font-size: 14px;
            color: #111;
        }

    @@media (max-width: 900px) {
        .profile-card {
            width: 95%;
            min-width: auto;
        }
    }
</style>

<div class="profile-wrapper">
    <div class="profile-card">
        <div class="profile-header">
            <div style="width:65px; height:65px; background:white; color:#5b3cc4; border-radius:50%; display:flex; align-items:center; justify-content:center; font-weight:900; font-size:28px;">
                @(Model?.FullName != null ? Model.FullName.Substring(0, 1).ToUpper() : "S")
            </div>
            <div>
                <h2>@Model?.FullName</h2>
                <div style="opacity:0.9; font-size:14px; font-weight:600;">Osun State University, Osogbo</div>
            </div>
        </div>

        <div class="profile-body">
            <div style="display:grid; grid-template-columns: 1fr 1fr; gap:18px;">
                <div class="info-box"><label>Full Name</label><span>@Model?.FullName</span></div>
                <div class="info-box"><label>Email Address</label><span>@Model?.Email</span></div>
                <div class="info-box"><label>Department</label><span>Computer Science</span></div>
                <div class="info-box"><label>Faculty</label><span>Computing and Information Technology</span></div>
                <div class="info-box"><label>Level</label><span>300 Level</span></div>
                <div class="info-box"><label>Academic Session</label><span>2024/2025</span></div>
                <div class="info-box"><label>Admission Type</label><span>UTME - Full Time</span></div>
                <div class="info-box"><label>Status</label><span style="color:green;">Active Student</span></div>
            </div>

            <a asp-controller="Dashboard" asp-action="Index" style="background:#111827; color:white; padding:12px 26px; border-radius:10px; text-decoration:none; display:inline-block; margin-top:25px; font-size:14px; font-weight:800;">Back to Dashboard</a>
        </div>
    </div>
</div>