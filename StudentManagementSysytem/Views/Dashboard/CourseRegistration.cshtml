@{
    ViewData["Title"] = "Course Registration";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    /* FULL SCREEN LIKE PAY FEES - ADD AT BOTTOM */
    .page-bg {
        width: 100vw !important;
        max-width: 100vw !important;
        margin-left: calc(-50vw + 50%) !important;
        margin-right: calc(-50vw + 50%) !important;
        min-height: 100vh !important;
        padding-left: 16px !important;
        padding-right: 16px !important;
        padding-top: 16px !important;
        box-sizing: border-box !important;
    }

    .header {
        width: 100% !important;
        max-width: 100% !important;
        margin-left: 0 !important;
        margin-right: 0 !important;
        box-sizing: border-box !important;
    }

    .grid {
        width: 100% !important;
        max-width: 100% !important;
        margin-left: 0 !important;
        margin-right: 0 !important;
        box-sizing: border-box !important;
        grid-template-columns: 1fr 360px !important;
        gap: 16px !important;
        align-items: start !important;
    }

    .page-bg {
        background: #f8f7ff;
        min-height: 85vh;
        padding: 28px;
    }

    .page-header {
        background: linear-gradient(135deg, #7c5cff 0%, #a48cff 100%);
        border-radius: 16px;
        padding: 26px 30px;
        color: white;
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
    }

    .header-left {
        display: flex;
        gap: 14px;
        align-items: center;
    }

    .header-icon {
        width: 46px;
        height: 46px;
        background: rgba(255,255,255,0.25);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .header-icon svg {
            width: 24px;
            height: 24px;
            fill: white;
        }

    .badge-semester {
        background: white;
        color: #7c5cff;
        padding: 8px 16px;
        border-radius: 20px;
        font-size: 18px;
        font-weight: 800;
    }

    .grid {
        display: grid;
        grid-template-columns: 1fr 320px;
        gap: 20px;
        max-width: 1200px;
        margin: 0 auto;
    }

    .card {
        background: white;
        border-radius: 16px;
        border: 1px solid #f0efff;
        box-shadow: 0 4px 20px rgba(124,92,255,0.06);
        padding: 22px;
    }

    .card-title {
        font-size: 15px;
        font-weight: 800;
        color: #111;
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 18px;
    }

        .card-title svg {
            width: 18px;
            height: 18px;
            fill: #8b5cf6;
        }

    .course-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 14px;
        border: 1px solid #f1f0ff;
        border-radius: 15px;
        margin-bottom: 12px;
        transition: 0.2s;
    }

        .course-row:hover {
            border-color: #8b5cf6;
            background: #fbfaff;
            transform: translateY(-1px);
        }

    .course-info {
        display: flex;
        gap: 12px;
        align-items: center;
    }

    .course-icon {
        width: 40px;
        height: 40px;
        background: #f3f0ff;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #8b5cf6;
        font-weight: 800;
        font-size: 12px;
    }

    .course-name {
        font-size: 18px;
        font-weight: 700;
        color: #111;
    }

    .course-code {
        font-size: 15px;
        color: #888;
        margin-top: 2px;
    }

    .course-meta {
        font-size: 10px;
        color: #666;
        display: flex;
        gap: 10px;
        margin-top: 4px;
    }

    .check {
        width: 22px;
        height: 22px;
        border: 2px solid #e5e1ff;
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
    }

        .check.active {
            background: #8b5cf6;
            border-color: #8b5cf6;
        }

        .check svg {
            width: 14px;
            height: 14px;
            fill: white;
            display: none;
        }

        .check.active svg {
            display: block;
        }

    .summary-row {
        display: flex;
        justify-content: space-between;
        font-size: 15px;
        padding: 15px 0;
        border-bottom: 1px dashed #eee;
    }

        .summary-row.total {
            font-weight: 800;
            color: #111;
            border: none;
            font-size: 15px;
        }

    .btn-reg {
        width: 100%;
        background: #8b5cf6;
        color: white;
        border: none;
        padding: 13px;
        border-radius: 10px;
        font-weight: 700;
        font-size: 15px;
        margin-top: 16px;
        cursor: pointer;
    }

        .btn-reg:hover {
            background: #7c3aed;
        }

    .filter {
        background: #f3f0ff;
        border: none;
        border-radius: 8px;
        padding: 8px 12px;
        font-size: 15px;
        color: #6b5b95;
        outline: none;
    }
</style>

<div class="page-bg">
    <div class="page-header">
        <div class="header-left">
            <div class="header-icon">
                <svg viewBox="0 0 24 24"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-2 10h-4v4h-2v-4H7v-2h4V7h2v4h4v2z" /></svg>
            </div>
            <div>
                <h3 style="margin:0; font-weight:800; font-size:18px;">Course Registration</h3>
                <p style="margin:2px 0 0; font-size:15px; opacity:0.9;">Select your courses for this semester</p>
            </div>
        </div>
        <div class="badge-semester">📅 First Semester 2024/2025</div>
    </div>

    <div class="grid">
        <!-- LEFT - AVAILABLE COURSES -->
        <div class="card">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:18px;">
                <div class="card-title">
                    <svg viewBox="0 0 24 24"><path d="M12 2L1 7l11 5 9-4.9V17h2V7L12 2z" /></svg>
                    Available Courses
                </div>
                <select class="filter">
                    <option>All Departments</option>
                    <option>Computer Science</option>
                    <option>General Studies</option>
                </select>
            </div>

            <!-- Course 1 -->
            <div class="course-row">
                <div class="course-info">
                    <div class="course-icon">CS101</div>
                    <div>
                        <div class="course-name">Introduction to Computing</div>
                        <div class="course-code">CSC 101 • 3 Units • Dr. A. Johnson</div>
                        <div class="course-meta"><span>⏰ Mon 8-10am</span><span>📍 LT1</span></div>
                    </div>
                </div>
                <div class="check active"><svg viewBox="0 0 24 24"><path d="M9 16.2L4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4L9 16.2z" /></svg></div>
            </div>

            <!-- Course 2 -->
            <div class="course-row">
                <div class="course-info">
                    <div class="course-icon">CS102</div>
                    <div>
                        <div class="course-name">Introduction to Programming</div>
                        <div class="course-code">CSC 102 • 3 Units • Prof. B. Okafor</div>
                        <div class="course-meta"><span>⏰ Tue 10-12pm</span><span>📍 Lab A</span></div>
                    </div>
                </div>
                <div class="check active"><svg viewBox="0 0 24 24"><path d="M9 16.2L4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4L9 16.2z" /></svg></div>
            </div>

            <!-- Course 3 -->
            <div class="course-row">
                <div class="course-info">
                    <div class="course-icon">MTH</div>
                    <div>
                        <div class="course-name">General Mathematics I</div>
                        <div class="course-code">MTH 101 • 3 Units • Dr. S. Ade</div>
                        <div class="course-meta"><span>⏰ Wed 8-10am</span><span>📍 LT2</span></div>
                    </div>
                </div>
                <div class="check"><svg viewBox="0 0 24 24"><path d="M9 16.2L4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4L9 16.2z" /></svg></div>
            </div>

            <!-- Course 4 -->
            <div class="course-row">
                <div class="course-info">
                    <div class="course-icon">GST</div>
                    <div>
                        <div class="course-name">Use of English</div>
                        <div class="course-code">GST 101 • 2 Units • Mrs. K. Peters</div>
                        <div class="course-meta"><span>⏰ Thu 2-4pm</span><span>📍 LT3</span></div>
                    </div>
                </div>
                <div class="check"><svg viewBox="0 0 24 24"><path d="M9 16.2L4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4L9 16.2z" /></svg></div>
            </div>
        </div>

        <!-- RIGHT - SUMMARY -->
        <div>
            <div class="card">
                <div class="card-title">
                    <svg viewBox="0 0 24 24"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-6 14h-2v-2h2v2zm0-4h-2V7h2v6z" /></svg>
                    Registration Summary
                </div>

                <div class="summary-row"><span>Selected Courses</span><b>2 Courses</b></div>
                <div class="summary-row"><span>Total Units</span><b>6 Units</b></div>
                <div class="summary-row"><span>Max Allowed</span><b style="color:#10b981;">24 Units</b></div>
                <div class="summary-row total"><span>Total to Pay</span><span style="color:#8b5cf6;">₦0.00</span></div>

                <button class="btn-reg">Register Selected Courses →</button>
                <p style="font-size:10px; color:#888; text-align:center; margin-top:10px;">You can add or drop courses before deadline</p>
            </div>

            <div class="card" style="margin-top:16px; background:#7c5cff; color:white; border:none;">
                <div style="font-size:18px; font-weight:700;">💡 Need Help?</div>
                <p style="font-size:15px; margin-top:6px; opacity:0.9; line-height:1.5;">Contact your course adviser before final submission. Deadline: 30th Oct, 2025</p>
            </div>
        </div>
    </div>
</div>

<script>
    document.querySelectorAll('.check').forEach(c => {
        c.addEventListener('click', () => c.classList.toggle('active'));
    });
</script>