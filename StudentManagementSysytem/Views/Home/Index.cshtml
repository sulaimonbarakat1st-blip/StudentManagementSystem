@model StudentManagementSystem.Models.RegisterViewModel
@using Microsoft.AspNetCore.Http

@if (Context.Session.GetString("UserName") != null)
{
    <div class="alert alert-success text-center">
        <h1>Welcome <b>@Context.Session.GetString("UserName")</b>!</h1>
    </div>
}
@{
    ViewData["Title"] = "Register";
    Layout = null;  // <-- This removes the navbar so we get full split screen
}
<!DOCTYPE html>
<html>
<head>
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
            body, html {
                margin: 0;
                height: 100%;
                font-family: 'Segoe UI', sans-serif;
            }

            .row {
                height: 100vh;
            }

            .left {
                background: #0d0d1a;
                color: white;
                padding: 4rem;
                display: flex;
                flex-direction: column;
                justify-content: center;
            }

            .right {
                background: #8b5cf6;
                display: flex;
                align-items: center;
                justify-content: center;
            }

            .form-control {
                background: transparent;
                border: none;
                border-bottom: 1px solid #555;
                border-radius: 0;
                color: white;
                padding: 10px 0;
            }

                .form-control:focus {
                    background: transparent;
                    box-shadow: none;
                    border-bottom: 1px solid #8b5cf6;
                    color: white;
                }

                .form-control::placeholder {
                    color: #aaa;
                }

            .btn-purple {
                background: #8b5cf6;
                border: none;
                padding: 12px;
                border-radius: 8px;
                width: 100%;
                font-weight: 600;
                transition: 0.3s;
            }

                .btn-purple:hover {
                    background: #7c3aed;
                    transform: translateY(-2px);
                }
            /* HOVER EFFECT */
            .welcome-box {
                background: rgba(255,255,255,0.1);
                padding: 3rem;
                border-radius: 20px;
                text-align: center;
                color: white;
            }

            a {
                color: #8b5cf6;
                text-decoration: none;
            }

                a:hover {
                    color: #a78bfa;
                }

            label {
                color: #aaa;
                font-size: 14px;
            }
    </style>
</head>

    <div class="row g-0">
        <!-- LEFT SIDE - REGISTRATION FORM -->
        <div class="col-md-6 left">
            <div class="text-center mb-4">
                <div class="rounded-circle mx-auto d-flex align-items-center justify-content-center mb-2" style="width:60px;height:60px;background:#8b5cf6">
                    <i class="bi bi-mortarboard-fill" style="font-size:30px;color:#fff"></i> <!-- STUDENT LOGO -->
                </div>
                <p class="fw-bold" style="color:#8b5cf6">Student Portal</p>
            </div>

            <h2 class="fw-bold mb-4">Create New Account</h2>

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">@TempData["Success"]</div>
            }

        <form asp-controller="Account" asp-action="Register" method="post">
                <div class="mb-3">
                    <label asp-for="FullName" class="form-label">Full Name</label>
                    <input asp-for="FullName" class="form-control" placeholder="Enter your name" required />
                </div>
                <div class="mb-3">
                    <label asp-for="Email" class="form-label">Email</label>
                    <input asp-for="Email" type="email" class="form-control" placeholder="Enter your email" required />
                </div>
                <div class="mb-4">
                    <label asp-for="Password" class="form-label">Password</label>
                    <input asp-for="Password" type="password" class="form-control" placeholder="Create password" required />
                </div>
            <button type="submit" class="btn btn-purple mb-3">Sign Up</button>
            </form>
            <p class="text-center small">Already have an account? <a asp-controller="Account" asp-action="Login">Login</a></p>
        </div>

        <!-- RIGHT SIDE - WELCOME -->
        <div class="col-md-6 right">
            <div class="welcome-box">
                <h2 class="fw-bold">Join Our<br>student portal</h2>
                <p class="small">Register to access your account</p>
                <img src="https://cdn-icons-png.flaticon.com/512/1995/1995567.png" style="width:200px" />
            </div>
        </div>
    </div>
